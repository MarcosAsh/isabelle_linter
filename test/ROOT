session Linter_Example = HOL +
  description "Example theories (isabelle linter -d test Linter_Example)."
  theories
    Example
    Unused
    Interp
    Simp_Only
    Diagnostic
    Def_Lints
    Def_Lints_Use
    Def_Lints_Code
    Simp_Scope

session Linter_Simp_Hygiene in simp_hygiene = HOL +
  description "simp_hygiene example, needs etc/simpstats.patch
    (isabelle linter -d test -o simp_hygiene_min=100 Linter_Simp_Hygiene)."
  theories
    Simp_Hygiene

session Linter_Imports in imports = HOL +
  description "Example theories for unused_imports (isabelle linter -l unused_imports -d test Linter_Imports)."
  theories
    Imports_User

session Linter_Imports_Ex in imports_ex = Linter_Imports +
  description "Builds on Linter_Imports, so unused_imports builds it too."
  theories
    Imports_Ex

session Linter_Parent_Lib in "parent/lib" = HOL +
  description "Example for isabelle linter_parent: a library session."
  theories
    Parent_Lib

session Linter_Parent_Client in "parent/client" = HOL +
  description "Example for isabelle linter_parent: re-checks Linter_Parent_Lib (isabelle linter_parent -d test Linter_Parent_Client)."
  sessions
    Linter_Parent_Lib
  theories
    Parent_Client
