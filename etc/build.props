title = Isabelle_Linter
module = $ISABELLE_LINTER_JAR
requirements = \
  env:ISABELLE_SCALA_JAR
sources = \
  src/core/syntax.scala \
  src/core/lemma.scala \
  src/core/pide.scala \
  src/core/tool.scala \
  src/lints/faster_step/faster_step.scala \
  src/lints/unused/unused.scala \
  src/lints/diagnostic_commands/diagnostic_commands.scala \
  src/collect/collect.scala \
  src/census/census.scala \
  src/retime/retime.scala
services = \
  isabelle.isabelle_linter.Tools
