title = Isabelle_Linter
module = $ISABELLE_LINTER_JAR
requirements = \
  env:ISABELLE_SCALA_JAR
sources = \
  src/core/syntax.scala \
  src/core/lemma.scala \
  src/core/pide.scala \
  src/core/downstream.scala \
  src/core/tool.scala \
  src/lints/definitions/definitions.scala \
  src/lints/datatype_plugins/datatype_plugins.scala \
  src/lints/fun_to_primrec/fun_to_primrec.scala \
  src/lints/faster_step/faster_step.scala \
  src/lints/unused/unused.scala \
  src/lints/diagnostic_commands/diagnostic_commands.scala \
  src/lints/simp_hygiene/simp_hygiene.scala \
  src/lints/unused_imports/theory_graph.scala \
  src/lints/unused_imports/patch.scala \
  src/lints/unused_imports/unused_imports.scala \
  src/lints/simp_scope/simp_text.scala \
  src/lints/simp_scope/simp_scope.scala \
  src/collect/collect.scala \
  src/census/census.scala \
  src/retime/retime.scala \
  src/parent/parent.scala
services = \
  isabelle.isabelle_linter.Tools
