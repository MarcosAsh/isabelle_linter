+(*  Title:      Pure/rule_statistics.ML
+
+How often the simplifier and the classical reasoner try each rule, for profiling.
+rule_statistics = NAME counts under NAME; "" (the default) counts nothing.
+*)
+
+signature RULE_STATISTICS =
+sig
+  val rule_statistics: string Config.T
+  type counts = {tried: int, matched: int, succeeded: int, time: Time.time}
+  type key = string * Thm_Name.T
+  type counter
+  val counter: Proof.context -> counter option
+  val count: counter -> (key * counts) list -> unit
+  val get: string -> (key * counts) list
+  val reset: string -> unit
+end;
+
+structure Rule_Statistics: RULE_STATISTICS =
+struct
+
+val rule_statistics = Config.declare_string ("rule_statistics", \<^here>) (K "");
+
+type counts = {tried: int, matched: int, succeeded: int, time: Time.time};
+
+(*kind of rule, like "simp", "simproc", "classical" or "blast", and its name*)
+type key = string * Thm_Name.T;
+
+structure Keytab =
+  Table(type key = string * Thm_Name.T val ord = prod_ord fast_string_ord Thm_Name.ord);
+
+type counter = counts Keytab.table Synchronized.var;
+
+
+(* counters by name *)
+
+(*read without the lock: it only changes when a name is first used or reset*)
+val counters = Unsynchronized.ref (Symtab.empty: counter Symtab.table);
+val counters_lock = Thread.Mutex.mutex ();
+
+fun change_counters f =
+  Multithreading.synchronized "Rule_Statistics" counters_lock (fn () =>
+    let val (res, tab) = f (! counters) in counters := tab; res end);
+
+fun new_counter name =
+  change_counters (fn tab =>
+    (case Symtab.lookup tab name of
+      SOME c => (c, tab)
+    | NONE =>
+        let val c = Synchronized.var ("Rule_Statistics " ^ name) Keytab.empty
+        in (c, Symtab.update (name, c) tab) end));
+
+fun the_counter name =
+  (case Symtab.lookup (! counters) name of
+    SOME c => c
+  | NONE => new_counter name);
+
+fun counter ctxt =
+  (case Config.get ctxt rule_statistics of
+    "" => NONE
+  | name => SOME (the_counter name));
+
+fun reset name = change_counters (fn tab => ((), Symtab.delete_safe name tab));
+
+
+(* counts *)
+
+val zero: counts = {tried = 0, matched = 0, succeeded = 0, time = Time.zeroTime};
+
+fun add (a: counts) (b: counts) =
+  {tried = #tried a + #tried b, matched = #matched a + #matched b,
+   succeeded = #succeeded a + #succeeded b, time = #time a + #time b};
+
+(*rules without a name do not count*)
+fun count c entries =
+  Synchronized.change c
+    (fold (fn (key as (_, name), counts) =>
+      if Thm_Name.is_empty name then I else Keytab.map_default (key, zero) (add counts)) entries);
+
+fun get name = Keytab.dest (Synchronized.value (the_counter name));
+
+end;
