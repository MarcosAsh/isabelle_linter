+(* statistics *)
+
+(*a rule without a name, like an equation of fun, counts under "??." and its head constant*)
+fun statistics_name ({name, elhs, ...}: rrule) =
+  if not (String.isPrefix "??." (#1 name)) then name
+  else
+    (case Term.head_of (Thm.term_of elhs) of
+      Const (c, _) => ("??." ^ c, 0)
+    | _ => name);
+
+fun count_proc NONE _ f = f ()
+  | count_proc (SOME counter) name f =
+      let
+        val start = Time.now ();
+        val res = f ();
+        val time = Time.now () - start;
+        val succeeded = if is_some res then 1 else 0;
+        val counts = {tried = 1, matched = 1, succeeded = succeeded, time = time};
+      in Rule_Statistics.count counter [(("simproc", (name, 0)), counts)]; res end;
+
+
 
