section "Isabelle_Linter"

public option linter_timeout : real = 30
  -- "seconds at most for one question to the prover"

public option linter_batch : int = 500
  -- "questions sent to the prover at once; a bigger round waits for each batch in turn"

public option linter_log : string = ""
  -- "append every question and its answer to this TSV file (empty: no log)"

public option linter_factor : real = 5
  -- "unused: an edited lemma gets this many times the original lemma's time (at least 1s)"

public option unused_runs : int = 3
  -- "unused: the lemma with and without the fix is timed this many times; medians are compared"

public option unused_imports_builds : int = 10
  -- "unused_imports: builds of the copy after the one with every proposed removal; removals not tried by then stay"

public option unused_imports_distribution : bool = false
  -- "unused_imports: also try imports of theories from the Isabelle distribution (Main, HOL-Library ...)"

public option unused_imports_dir : string = ""
  -- "unused_imports: copy the session's directory into this directory and keep it (empty: a temporary one)"

public option faster_step_slow : real = 1.0
  -- "faster_step: only `by` steps that take at least this many seconds are tried"

public option faster_step_speedup : real = 2
  -- "faster_step: a replacement must be this many times faster than the original step"

public option faster_step_runs : int = 3
  -- "faster_step: the winner and the original are re-timed this many times; medians are compared"

public option faster_step_try0 : bool = false
  -- "faster_step: also run try0 on each step it searches and re-time try0's proof, for the question log (HOL only)"

public option faster_step_try0_timeout : real = 0
  -- "faster_step: seconds for each method try0 runs, 0 for try0's own default (try0_default_timeout)"

public option simp_hygiene_min : int = 1000
  -- "simp_hygiene: a rule or simproc is reported once it is tried at least this often in the session"

public option collect_timeout : real = 2
  -- "linter_collect: seconds each method gets on a step"

public option collect_runs : int = 3
  -- "linter_collect: a method that closes is re-timed this many times; the median is kept"

public option collect_parallel : int = 4
  -- "linter_collect: steps re-timed at the same time"

public option collect_batch : int = 100
  -- "linter_collect: steps whose methods are tried at the same time"

public option collect_sledgehammer : real = 0
  -- "linter_collect: seconds for Sledgehammer on each step, 0 to skip"

public option retime_runs : int = 3
  -- "linter_retime: each step is run this many times; the median is kept"

public option retime_factor : real = 3
  -- "linter_retime: a run gets this many times the step's census time (at least 10s)"
